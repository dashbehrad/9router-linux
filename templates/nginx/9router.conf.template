# 9router Linux - Nginx Reverse Proxy Configuration
# Managed by 9router Linux Installer

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# HTTP - Redirect to HTTPS and serve ACME challenge for Let's Encrypt
server {
    listen __HTTP_PORT__;
    listen [::]:__HTTP_PORT__;
    server_name __SERVER_NAME__;

    # Let's Encrypt ACME Challenge verification directory
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    # Redirect all HTTP requests to HTTPS
    location / {
        return 301 https://$host__REDIRECT_PORT__$request_uri;
    }
}

# HTTPS - Secure Reverse Proxy for 9router
server {
    listen __HTTPS_PORT__ ssl http2;
    listen [::]:__HTTPS_PORT__ ssl http2;
    server_name __SERVER_NAME__;

    # SSL Certificate & Private Key
    ssl_certificate __SSL_CERT__;
    ssl_certificate_key __SSL_KEY__;

    # Modern TLS Security
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers HIGH:!aNULL:!MD5:!3DES;
    ssl_session_cache shared:9router_ssl:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Security Headers
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Support large context payloads and base64 images (matches 9router max size)
    client_max_body_size 128M;

    # ACME Challenge location on HTTPS as well
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    # Proxy to 9router Node.js backend
    location / {
        proxy_pass http://127.0.0.1:__APP_PORT__;
        proxy_http_version 1.1;

        # WebSocket & HTTP Upgrade support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Client IP and Host headers (custom-server.js uses X-Real-IP)
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Disable buffering for Server-Sent Events (SSE) streaming
        proxy_buffering off;
        proxy_cache off;

        # Extended timeouts for long LLM generation & reasoning responses
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_connect_timeout 60s;
    }
}
